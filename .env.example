# Copy this file to .env and fill in real values. Never commit .env itself.

# Discord webhook URL to post alerts to.
DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional -- a separate webhook (ideally a different channel) for PVP
# top-rank alerts. If unset, that feature is simply disabled.
# PVP_DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Base URL of the target deployment.
API_BASE=https://example.invalid

# The exact cookie name your target deployment uses -- check your browser's
# devtools (Network tab -> any API request -> Cookie header) for the name.
COOKIE_NAME=REPLACE_WITH_YOUR_DEPLOYMENT_COOKIE_NAME

# Session cookie value captured from your own logged-in browser session.
SESSION_COOKIE=REPLACE_WITH_YOUR_OWN_SESSION_COOKIE_VALUE

# Your area of interest (decimal degrees).
MIN_LAT=0.0
MAX_LAT=0.0
MIN_LON=0.0
MAX_LON=0.0

# Optional -- uncomment to use.
# MAX_RUNTIME_SECONDS=20700

# Optional -- mirror a match alert to a second webhook (ideally a different
# channel) whenever it falls inside this smaller bbox nested within
# MIN_LAT/MAX_LAT/MIN_LON/MAX_LON above. If ZONE_WEBHOOK is unset, this is
# simply disabled; if it's set, all four bounds below must also be set.
# ZONE_WEBHOOK=https://discord.com/api/webhooks/XXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# ZONE_MIN_LAT=0.0
# ZONE_MAX_LAT=0.0
# ZONE_MIN_LON=0.0
# ZONE_MAX_LON=0.0
